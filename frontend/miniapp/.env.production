# Production build — API base URL must be configured at deploy time.
# 零域名路线（docs/13 §3.1）：填 https://<IP点改横线>.sslip.io，例 https://203-0-113-10.sslip.io
# 购买域名路线：填 https://<你的域名>
# For local preview against a running backend, override with:
#   VITE_API_BASE_URL=http://localhost:8080 npm run build:h5
VITE_API_BASE_URL=

# 真机调试必须用电脑的局域网 IP，不能用 localhost/127.0.0.1。
# 当前采用「电脑开移动热点给手机连」方案，网关固定为 192.168.137.1。
# 上线前必须替换为 HTTPS 的线上 API，并在小程序后台配置 request 合法域名。
# Updated 2026-08-02.
VITE_MP_API_BASE_URL=http://192.168.137.1:8080
VITE_MP_API_BASE_FALLBACK_URLS=
