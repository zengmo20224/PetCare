# PetCare O2O 环境变量样例
# 关联文档：docs/03-configuration-management-plan.md §7.2、docs/07-deployment-guide.md §3
# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
# 禁止将真实密钥提交到版本库（CMP §1.4 / AGENTS.md 第 4 条）。

# ========== 镜像版本 ==========
# 用于 docker-compose.yml 指定镜像 tag，与 git tag 基线对应
IMAGE_TAG=1.0.0

# ========== MySQL 数据库 ==========
# docker-compose 内部用 mysql:3306；本地开发用 localhost:3306
DB_URL=jdbc:mysql://mysql:3306/petcare_o2o?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=petcare
DB_PASSWORD=changeme

# MySQL 容器初始化用（仅首次创建数据卷时生效）
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=petcare_o2o

# ========== JWT 认证 ==========
# 生产环境必须设置 ≥ 32 字符的随机字符串
JWT_SECRET=
JWT_ISSUER=petcare-o2o-api
JWT_EXPIRATION_MINUTES=120

# ========== AI Provider（V1，客服对话 + 经营分析报告）==========
# D-004 修订：未配 DEEPSEEK_API_KEY 时返回 503，不影响应用启动
# ── 生产启用（已拍板开启）：AI_PROVIDER_ENABLED=true 并填入真实 key；
#    key 用全新生成的（本机开发用过的建议在 DeepSeek 控制台轮换废弃）
AI_PROVIDER_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ========== V2 AI Agent（D-013，默认关闭，缺值不影响启动）==========
# Agent 能力（RAG 检索 + 工具调用）；启用需同时起 postgres 容器
# ── 生产启用（已拍板开启）：AI_AGENT_ENABLED=true + AI_RAG_ENABLED=true
AI_AGENT_ENABLED=false
AI_RAG_ENABLED=false
# PgVector 连接（独立 PG 实例，仅 AI_AGENT_ENABLED=true 时依赖）
PGVECTOR_HOST=postgres
PGVECTOR_PORT=5432
PGVECTOR_DB=petcare_ai
PGVECTOR_USER=petcare
# ⚠️ 生产必改：changeme 会被视为弱凭据；openssl rand -base64 24 生成
PGVECTOR_PASSWORD=changeme
# Embedding（本地 ONNX 推理，零外部 API 费用）
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_EMBEDDING_DIM=384
AI_EMBEDDING_ONNX_PATH=./models/all-MiniLM-L6-v2/model.onnx
# 检索与限流
AI_RAG_TOP_K=5
AI_AGENT_RATE_LIMIT_PER_MIN=20
# 每日额度（上线加固）：每用户/全站 AI 调用每日上限，0=关闭；发帖仅 Provider 启用时计入
# ⚠️ 生产必配：GLOBAL 默认 0 表示"多账号刷量兜底"未生效——上线必须设为有限值（推荐 500）
AI_AGENT_DAILY_LIMIT_PER_USER=50
AI_AGENT_DAILY_LIMIT_GLOBAL=0
# 审核与知识库（NSFW 模型渠道 M8.4 决策；rebuild 定时任务）
AI_MODERATION_NSFW_THRESHOLD=0.8
AI_KNOWLEDGE_REBUILD_CRON=0 0 3 * * *

# ========== 端口映射（docker-compose）==========
# 宿主机访问端口（演示用默认值）
ADMIN_WEB_PORT=8080
H5_PORT=8081
API_PORT=8082
MYSQL_PORT=3307

# ========== Jenkins 邮件通知（可选，加分项）==========
# 见 jenkins/README.md §4
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
TEAM_EMAIL=
