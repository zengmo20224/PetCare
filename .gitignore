docker-compose.override.yml

# Docker runtime volumes（防止误提交容器数据）
mysql-data/
*.tar

# Maven local repo（Jenkins 流水线内 .m2-repo）
.m2-repo/

# CI 测试报告产物（不进版本库，由 CI 归档）
target/site/jacoco/
frontend/*/coverage/

# 审计证据（图片/视频可能较大，按需手动归档）
docs/audit-evidence/**/*.mp4
docs/audit-evidence/**/*.mov

# Agent/工具临时产物（不纳入版本库）
.claude/
.zcode/
docgen/

# 微信小程序个人配置（含 appid / 本地路径，不应共享）
# 项目当前主目标为 H5，小程序工程配置暂不纳入版本库（AGENTS.md §2）
project.private.config.json
project.config.json
**/project.private.config.json
**/project.config.json

# 误产物（Windows nul 是保留设备名，不应作为文件存在）
nul

# 一次性交付/课程文档（二进制，体积大，不纳入版本库；本地保留）
*.docx
*.pptx
*.zip

# 本地临时截图目录
tmp-ui-shots/

# Playwright MCP 工具产物（本地调试用，不入库）
.playwright-mcp/

# V2 AI Agent 模型文件（>50MB，走 release 附件/对象存储，CI 下载并校验 sha256）
# docs/09-ai-agent-design.md §7.2/§8；models/README.md 记录获取方式与校验值
models/**/*.onnx
models/**/*.bin
models/**/*.safetensors

# 迭代过程截图存档（本根目录散落 PNG 的归档处，不入库）
.screenshots/
